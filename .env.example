# PayPal sandbox REST app (developer.paypal.com > Apps & Credentials > Sandbox).
# Link the app to a US business sandbox account so the Payouts API is available.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_BASE=https://api-m.sandbox.paypal.com
# Optional: webhook ID from the app's Webhooks section (needs a public URL, e.g. on Render)
PAYPAL_WEBHOOK_ID=

# Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=

# Key that outside agents (MCP server, SDK) and seller registration must send.
# Leave empty to allow only local callers.
AGENTPAY_API_KEY=

# Sandbox emails that receive seller payouts
AGENT_B_EMAIL=
BUDGET_SELLER_EMAIL=

# Owner mandate defaults
DAILY_SPEND_CAP=1.00
PER_CALL_MAX=0.10
APPROVAL_THRESHOLD=0.05
MAX_BUYS_PER_MINUTE=30

# Show the simulated "Add demo credit" button
DEMO_FUNDING=true
MAX_RUNS_PER_DAY=30
PORT=3000

# One wallet per visitor on a public demo (shared | per-visitor)
WALLET_MODE=shared
